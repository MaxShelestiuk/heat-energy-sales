<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_consumer_category_list" model="ir.ui.view">
        <field name="name">heat.consumer.category.list</field>
        <field name="model">heat.consumer.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_consumer_category_form" model="ir.ui.view">
        <field name="name">heat.consumer.category.form</field>
        <field name="model">heat.consumer.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_consumer_category" model="ir.actions.act_window">
        <field name="name">Consumer Categories</field>
        <field name="res_model">heat.consumer.category</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_tariff_list" model="ir.ui.view">
        <field name="name">heat.tariff.list</field>
        <field name="model">heat.tariff</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="price_per_gcal"/>
                <field name="currency_id"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_tariff_form" model="ir.ui.view">
        <field name="name">heat.tariff.form</field>
        <field name="model">heat.tariff</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="price_per_gcal"/>
                        <field name="currency_id"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_tariff" model="ir.actions.act_window">
        <field name="name">Tariffs</field>
        <field name="res_model">heat.tariff</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
