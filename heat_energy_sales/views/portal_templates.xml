<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="portal_heat_home" inherit_id="portal.portal_my_home" name="Heat Bills Portal Entry">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/heat_energy_sales/static/description/icon.png'"/>
                <t t-set="title">Heat Bills</t>
                <t t-set="url" t-value="'/my/heat-bills'"/>
                <t t-set="text">View your monthly heat consumption and download bills</t>
                <t t-set="placeholder_count" t-value="'heat_bill_count'"/>
            </t>
        </div>
    </template>
    <template id="portal_heat_breadcrumbs" inherit_id="portal.portal_breadcrumbs" name="Heat Bills Breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'heat_bills'" class="breadcrumb-item">
                <a href="/my/heat-bills">Heat Bills</a>
            </li>
            <li t-if="page_name == 'heat_bills' and heat_bill" class="breadcrumb-item active">
                <span t-field="heat_bill.name"/>
            </li>
        </xpath>
    </template>
    <template id="portal_heat_bills" name="My Heat Bills">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Heat Bills</t>
            </t>
            <p t-if="not heat_bills" class="alert alert-info">No issued heat bills are available.</p>
            <t t-if="heat_bills" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>Bill</th>
                        <th>Period</th>
                        <th class="text-end">Gcal</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="heat_bills" t-as="bill">
                        <td>
                            <a t-attf-href="/my/heat-bills/#{bill.id}">
                                <span t-field="bill.name"/>
                            </a>
                        </td>
                        <td>
                            <span t-field="bill.period_start"/> - <span t-field="bill.period_end"/>
                        </td>
                        <td class="text-end">
                            <span t-field="bill.energy_total_gcal"/>
                        </td>
                        <td class="text-end">
                            <span t-field="bill.amount_untaxed"/>
                        </td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>
    <template id="portal_heat_bill" name="Heat Bill Details">
        <t t-call="portal.portal_layout">
            <div class="d-flex justify-content-between align-items-center my-4">
                <h2>
                    <span t-field="heat_bill.name"/>
                </h2>
                <a class="btn btn-primary" t-attf-href="/my/heat-bills/#{heat_bill.id}?report_type=pdf&amp;download=1">Download PDF</a>
            </div>
            <p>
                <strong>Consumer:</strong>
                <span t-field="heat_bill.consumer_id.name"/>
            </p>
            <p>
                <strong>Period:</strong>
                <span t-field="heat_bill.period_start"/> - <span t-field="heat_bill.period_end"/>
            </p>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Object</th>
                            <th>Actual consumer</th>
                            <th>Method</th>
                            <th>Category</th>
                            <th class="text-end">Gcal</th>
                            <th class="text-end">Price / Gcal</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="heat_bill.line_ids" t-as="line">
                            <td>
                                <span t-field="line.supply_object_id.name"/>
                            </td>
                            <td>
                                <span t-field="line.actual_consumer_id.name"/>
                            </td>
                            <td>
                                <span t-field="line.calculation_method"/>
                            </td>
                            <td>
                                <span t-field="line.category_id.name"/>
                            </td>
                            <td class="text-end">
                                <span t-field="line.quantity_gcal"/>
                            </td>
                            <td class="text-end">
                                <span t-field="line.price_unit"/>
                            </td>
                            <td class="text-end">
                                <span t-field="line.subtotal"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="text-end">
                <strong>Energy consumed:</strong>
                <span t-field="heat_bill.energy_total_gcal"/> Gcal</p>
            <p class="text-end">
                <strong>Total excluding VAT:</strong>
                <span t-field="heat_bill.amount_untaxed"/>
            </p>
        </t>
    </template>
</odoo>
